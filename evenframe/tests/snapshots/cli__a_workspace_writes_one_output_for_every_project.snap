import { scope } from 'arktype';

export const bindings = scope({

Address: {
  city: 'string'
},
Account: {
  id: 'string',
  home: 'Address'
},
Deal: {
  id: 'string',
  address: 'Address'
},

});

const exported = bindings.export();

export type Address = typeof exported.Address.infer;
export type Account = typeof exported.Account.infer;
export type Deal = typeof exported.Deal.infer;

export const validator = exported;
