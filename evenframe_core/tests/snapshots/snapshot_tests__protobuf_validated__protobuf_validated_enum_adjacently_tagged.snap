syntax = "proto3";

message Event {
    message Scroll {
    }
    oneof variant {
        .ClickData click = 1;
        string key_press = 2;
        Scroll scroll = 3;
    }
}

message ClickData {
    int32 x = 1;
    int32 y = 2;
}
