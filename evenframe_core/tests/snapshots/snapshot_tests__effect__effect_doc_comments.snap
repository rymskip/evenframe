/** Severity levels for log output */export const LogLevel = Schema.Union(Schema.Literal("Debug"), Schema.Literal("Info"), Schema.Literal("Warn"), Schema.Literal("Error")).annotations({ identifier: `LogLevel` });
/** Application configuration settings */export class Config extends Schema.Class<Config>("Config")( { 
  /** The API key used for authentication */  api_key: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'Api Key' is required` }),
  /** Request timeout in milliseconds */  timeout_ms: Schema.propertySignature(Schema.Number).annotations({ missingMessage: () => `'Timeout Ms' is required` })
}) {[key: string]: unknown}


export type LogLevelEncoded = "Debug" | "Info" | "Warn" | "Error";

export interface ConfigEncoded {
  readonly api_key: string;
  readonly timeout_ms: number;
}


export type LogLevelType = typeof LogLevel.Type;
export type ConfigType = typeof Config.Type;
