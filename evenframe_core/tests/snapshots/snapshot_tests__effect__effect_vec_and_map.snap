export type RoleEncoded = "Admin" | "Member";

export interface CollectionEncoded {
  readonly id: string;
  readonly tags: ReadonlyArray<string>;
  readonly scores: ReadonlyArray<number>;
  readonly metadata: Record<string, string>;
  readonly sorted_data: Record<string, number>;
  readonly notes_by_rank: Record<string, string | null | undefined>;
  readonly related_by_name: Record<string, { readonly table: string; readonly key: { readonly String: string } | { readonly Number: number } | { readonly Uuid: string } } | CollectionEncoded>;
  readonly balance_by_offset: Record<string, number>;
  readonly count_by_letter: Record<string, number>;
  readonly owner_by_role: Partial<Record<RoleEncoded, string>>;
  readonly label_by_account: Record<string, string>;
  readonly grid: Record<string, Record<string, boolean>>;
  readonly initial: string;
  readonly note_by_flag: Partial<Record<"true" | "false", string>>;
}


export type RoleType = typeof Role.Type;
export type CollectionType = typeof Collection.Type;
