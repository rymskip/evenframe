  notes_by_rank: Schema.propertySignature(Schema.Record({ key: Schema.String.pipe(Schema.pattern(new RegExp("^(?:0|-?[1-9][0-9]*)$"))), value: Schema.OptionFromNullishOr(Schema.String, null) }).annotations({ parseOptions: { onExcessProperty: "error" } })).annotations({ missingMessage: () => `'Notes By Rank' is required` }),
  related_by_name: Schema.propertySignature(Schema.Record({ key: Schema.String, value: Schema.Union(Schema.Struct({ table: Schema.String, key: Schema.Union(Schema.Struct({ String: Schema.String }), Schema.Struct({ Number: Schema.Number.pipe(Schema.int()) }), Schema.Struct({ Uuid: Schema.UUID })) }), Schema.suspend((): Schema.Schema<Collection, CollectionEncoded> => Collection).annotations({ identifier: `CollectionRef` })) }).annotations({ parseOptions: { onExcessProperty: "error" } })).annotations({ missingMessage: () => `'Related By Name' is required` }),
  balance_by_offset: Schema.propertySignature(Schema.Record({ key: Schema.String.pipe(Schema.pattern(new RegExp("^(?:0|-?[1-9][0-9]*)$"))), value: Schema.Number }).annotations({ parseOptions: { onExcessProperty: "error" } })).annotations({ missingMessage: () => `'Balance By Offset' is required` }),
  count_by_letter: Schema.propertySignature(Schema.Record({ key: Schema.String.pipe(Schema.pattern(new RegExp("^(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\uD800-\\uDFFF])$"))), value: Schema.Number }).annotations({ parseOptions: { onExcessProperty: "error" } })).annotations({ missingMessage: () => `'Count By Letter' is required` }),
  owner_by_role: Schema.propertySignature(Schema.Record({ key: Role, value: Schema.String }).pipe(Schema.partialWith({ exact: true })).annotations({ parseOptions: { onExcessProperty: "error" } })).annotations({ missingMessage: () => `'Owner By Role' is required` }),
