syntax = "proto3";

message Shape {
    message Point {
    }
    oneof variant {
        .CircleData circle = 1;
        .RectangleData rectangle = 2;
        Point point = 3;
    }
}

message CircleData {
    double radius = 1;
}

message RectangleData {
    double width = 1;
    double height = 2;
}
