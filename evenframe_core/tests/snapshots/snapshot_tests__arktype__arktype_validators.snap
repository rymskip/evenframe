export const bindings = scope({

Registration: {
  email: [[['string', '&', 'string.email'], '&', 'string <= 255'], '&', 'string >= 5'],
  username: [[['string', '&', 'string.alphanumeric'], '&', 'string >= 3'], '&', 'string <= 50'],
