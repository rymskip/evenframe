export const bindings = scope({

Address: {
  street: 'string',
  city: 'string'
},
Person: {
  name: 'string',
  home_address: 'Address',
  work_address: [['Address', '|', 'undefined'], '|', 'null']
},

});

const exported = bindings.export();

export const defaultAddress: Address = {
street: "",
city: ""
};
export const defaultPerson: Person = {
name: "",
home_address: { street: "", city: "" },
work_address: null
};

export type Address = typeof exported.Address.infer;
export type Person = typeof exported.Person.infer;
