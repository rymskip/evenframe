export class Signup extends Schema.Class<Signup>("Signup")( { 
  username: Schema.propertySignature(Schema.String.pipe(Schema.pattern(new RegExp("^[0-9A-Za-z]*$"), { message: () => `'Username' must be only letters and digits 0-9` })).pipe(Schema.pattern(new RegExp("^[a-z]*$"), { message: () => `'Username' must be only lowercase letters` })).pipe(Schema.minLength(1, { message: () => `'Username' must be at least 1 characters long` })).pipe(Schema.minLength(3, { message: () => `'Username' must be at least 3 characters long` })).pipe(Schema.maxLength(20, { message: () => `'Username' must be at most 20 characters long` }))).annotations({ missingMessage: () => `'Username' is required` }),
  code: Schema.propertySignature(Schema.String.pipe(Schema.pattern(new RegExp("^[0-9A-Fa-f]+$"), { message: () => `'Code' must be hex characters only` })).pipe(Schema.pattern(new RegExp("^[0-9]*$"), { message: () => `'Code' must be only digits 0-9` })).pipe(Schema.filter((value) => value.startsWith("0"), { message: () => `'Code' must be a value starting with "0"` })).pipe(Schema.filter((value) => value.startsWith("00"), { message: () => `'Code' must be a value starting with "00"` }))).annotations({ missingMessage: () => `'Code' is required` }),
  token: Schema.propertySignature(Schema.String.pipe(Schema.pattern(new RegExp("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"), { message: () => `'Token' must be a UUIDv4` })).pipe(Schema.filter((value) => value.toLowerCase() === value, { message: () => `'Token' must be lowercase` })).pipe(Schema.filter((value) => (() => { try { JSON.parse(value); return true; } catch { return false; } })(), { message: () => `'Token' must be a JSON string` }))).annotations({ missingMessage: () => `'Token' is required` }),
  banner: Schema.OptionFromNullishOr(Schema.String.pipe(Schema.pattern(new RegExp("^[A-Z][^\\n\\r\\u2028\\u2029]*$"), { message: () => `'Banner' must be capitalized` })).pipe(Schema.filter((value) => value.includes("!"), { message: () => `'Banner' must be a value containing "!"` })), null),
  ratio: Schema.propertySignature(Schema.Number.pipe(Schema.positive({ message: () => `'Ratio' must be a positive number` })).pipe(Schema.greaterThanOrEqualTo(0.001, { message: () => `'Ratio' must be greater than or equal to 0.001` })).pipe(Schema.lessThan(1000, { message: () => `'Ratio' must be less than 1000` })).pipe(Schema.lessThanOrEqualTo(999.999, { message: () => `'Ratio' must be less than or equal to 999.999` })).pipe(Schema.finite({ message: () => `'Ratio' must be a finite number` }))).annotations({ missingMessage: () => `'Ratio' is required` }),
  level: Schema.propertySignature(Schema.Number.pipe(Schema.greaterThan(0.5, { message: () => `'Level' must be greater than 0.5` })).pipe(Schema.int({ message: () => `'Level' must be an integer` })).pipe(Schema.between(0, 255, { message: () => `'Level' must be between 0 and 255` })).pipe(Schema.lessThan(9.5, { message: () => `'Level' must be less than 9.5` }))).annotations({ missingMessage: () => `'Level' is required` }),
  tags: Schema.OptionFromNullishOr(Schema.Array(Schema.String).pipe(Schema.minItems(1, { message: () => `'Tags' must contain at least 1 items` })).pipe(Schema.maxItems(5, { message: () => `'Tags' must contain at most 5 items` })), null),
  address: Schema.propertySignature(Schema.String.pipe(Schema.filter((value) => new RegExp("^(?:(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])[.]){3}(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$").test(value) || new RegExp("^((?:[0-9a-fA-F]{1,4}:){7}(?:[0-9a-fA-F]{1,4}|:)|(?:[0-9a-fA-F]{1,4}:){6}(?:(?:(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])[.]){3}(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])|:[0-9a-fA-F]{1,4}|:)|(?:[0-9a-fA-F]{1,4}:){5}(?::(?:(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])[.]){3}(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])|(:[0-9a-fA-F]{1,4}){1,2}|:)|(?:[0-9a-fA-F]{1,4}:){4}(?:(:[0-9a-fA-F]{1,4}){0,1}:(?:(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])[.]){3}(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])|(:[0-9a-fA-F]{1,4}){1,3}|:)|(?:[0-9a-fA-F]{1,4}:){3}(?:(:[0-9a-fA-F]{1,4}){0,2}:(?:(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])[.]){3}(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])|(:[0-9a-fA-F]{1,4}){1,4}|:)|(?:[0-9a-fA-F]{1,4}:){2}(?:(:[0-9a-fA-F]{1,4}){0,3}:(?:(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])[.]){3}(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])|(:[0-9a-fA-F]{1,4}){1,5}|:)|(?:[0-9a-fA-F]{1,4}:){1}(?:(:[0-9a-fA-F]{1,4}){0,4}:(?:(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])[.]){3}(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])|(:[0-9a-fA-F]{1,4}){1,6}|:)|(?::((?::[0-9a-fA-F]{1,4}){0,5}:(?:(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])[.]){3}(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])|(?::[0-9a-fA-F]{1,4}){1,7}|:)))(%[0-9a-zA-Z.]{1,})?$").test(value), { message: () => `'Address' must be an IP address` }))).annotations({ missingMessage: () => `'Address' is required` })
}) {[key: string]: unknown}


export interface SignupEncoded {
  readonly username: string;
  readonly code: string;
  readonly token: string;
  readonly banner: string | null | undefined;
  readonly ratio: number;
  readonly level: number;
  readonly tags: ReadonlyArray<string> | null | undefined;
  readonly address: string;
}


export type SignupType = typeof Signup.Type;
