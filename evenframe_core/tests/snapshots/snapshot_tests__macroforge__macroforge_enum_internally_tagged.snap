/** @derive(Decode) */
export interface CircleData {
  radius: number;
}

/** @derive(Decode) */
export interface RectangleData {
  width: number;
  height: number;
}

/** @derive(Decode) */
/** @endec({ tag: "type" }) */
export type Shape =
	| { type: "Circle" } & CircleData
	| { type: "Rectangle" } & RectangleData
	| { type: "Point" };
