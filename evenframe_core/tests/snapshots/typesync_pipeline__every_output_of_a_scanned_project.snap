=== 3-macroforge/macroforge.ts
import type { RecordIdEncoded } from '../record-id.ts';

export type RecordLink<T> = RecordIdEncoded | T;

/** @derive(Deserialize) */
export interface Address {
  street: string;
  city: string | null;
}

/** @derive(Deserialize) */
export interface Author {
  id: string;
  name: string;
  home: Address;
}

/** @derive(Deserialize) */
export interface Comment {
  body: string;
  replies: Reply[];
}

/** @derive(Deserialize) */
export interface Post {
  id: string;
  title: string;
  author: RecordLink<Author>;
  read_time: { secs: number; nanos: number };
  status: Status;
  location: Address;
  outline: Section | null;
  comments: Comment[];
}

/** @derive(Deserialize) */
export interface Reply {
  body: string;
  thread: Comment[];
}

/** @derive(Deserialize) */
export interface Scheduled {
  at: string;
  note: string | null;
}

/** @derive(Deserialize) */
export interface Section {
  heading: string;
  children: Section[];
}

/** @derive(Deserialize) */
/** @serde({ externallyTagged: true }) */
export type Status =
	| "Draft"
	| { Scheduled: Scheduled }
	| { Archived: string };

