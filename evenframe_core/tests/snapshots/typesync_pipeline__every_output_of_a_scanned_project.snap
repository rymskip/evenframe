import { Schema } from "effect";
import { RecordIdCodec } from '../record-id.ts';

export class Scheduled extends Schema.Class<Scheduled>("Scheduled")( { 
  at: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'At' is required` }),
  note: Schema.OptionFromNullishOr(Schema.String, null)
}) {[key: string]: unknown}

export const Status = Schema.Union(Schema.Literal("Draft"), Schema.Struct({ Scheduled: Scheduled }), Schema.Struct({ Archived: Schema.String })).annotations({ identifier: `Status` });
export class Section extends Schema.Class<Section>("Section")( { 
  heading: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'Heading' is required` }),
  children: Schema.propertySignature(Schema.Array(Schema.suspend((): Schema.Schema<Section, SectionEncoded> => Section).annotations({ identifier: `SectionRef` }))).annotations({ missingMessage: () => `'Children' is required` })
}) {[key: string]: unknown}

export class Comment extends Schema.Class<Comment>("Comment")( { 
  body: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'Body' is required` }),
  replies: Schema.propertySignature(Schema.Array(Schema.suspend((): Schema.Schema<Reply, ReplyEncoded> => Reply).annotations({ identifier: `ReplyRef` }))).annotations({ missingMessage: () => `'Replies' is required` })
}) {[key: string]: unknown}

export class Reply extends Schema.Class<Reply>("Reply")( { 
  body: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'Body' is required` }),
  thread: Schema.propertySignature(Schema.Array(Comment)).annotations({ missingMessage: () => `'Thread' is required` })
}) {[key: string]: unknown}

export class Address extends Schema.Class<Address>("Address")( { 
  street: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'Street' is required` }),
  city: Schema.OptionFromNullishOr(Schema.String, null)
}) {[key: string]: unknown}

export class Author extends Schema.Class<Author>("Author")( { 
  id: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'Id' is required` }),
  name: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'Name' is required` }),
  home: Schema.propertySignature(Address).annotations({ missingMessage: () => `'Home' is required` })
}) {[key: string]: unknown}

export class Post extends Schema.Class<Post>("Post")( { 
  id: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'Id' is required` }),
  title: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'Title' is required` }),
  author: Schema.propertySignature(Schema.Union(RecordIdCodec.schema, Author)).annotations({ missingMessage: () => `'Author' is required` }),
  read_time: Schema.propertySignature(Schema.Struct({ secs: Schema.Number.pipe(Schema.int(), Schema.nonNegative()), nanos: Schema.Number.pipe(Schema.int(), Schema.between(0, 999999999)) }).annotations({ parseOptions: { onExcessProperty: "error" } })).annotations({ missingMessage: () => `'Read Time' is required` }),
  status: Schema.propertySignature(Status).annotations({ missingMessage: () => `'Status' is required` }),
  location: Schema.propertySignature(Address).annotations({ missingMessage: () => `'Location' is required` }),
  outline: Schema.OptionFromNullishOr(Section, null),
  comments: Schema.propertySignature(Schema.Array(Comment)).annotations({ missingMessage: () => `'Comments' is required` })
}) {[key: string]: unknown}


export interface ScheduledEncoded {
  readonly at: string;
  readonly note: string | null | undefined;
}

export type StatusEncoded = "Draft" | { readonly Scheduled: ScheduledEncoded } | { readonly Archived: string };

export interface SectionEncoded {
  readonly heading: string;
  readonly children: ReadonlyArray<SectionEncoded>;
}

export interface CommentEncoded {
  readonly body: string;
  readonly replies: ReadonlyArray<ReplyEncoded>;
}

export interface ReplyEncoded {
  readonly body: string;
  readonly thread: ReadonlyArray<CommentEncoded>;
}

export interface AddressEncoded {
  readonly street: string;
  readonly city: string | null | undefined;
}

export interface AuthorEncoded {
  readonly id: string;
  readonly name: string;
  readonly home: AddressEncoded;
}

export interface PostEncoded {
  readonly id: string;
  readonly title: string;
  readonly author: Schema.Schema.Encoded<typeof RecordIdCodec.schema> | AuthorEncoded;
  readonly read_time: {
  readonly secs: number;
  readonly nanos: number;
};
  readonly status: StatusEncoded;
  readonly location: AddressEncoded;
  readonly outline: SectionEncoded | null | undefined;
  readonly comments: ReadonlyArray<CommentEncoded>;
}


