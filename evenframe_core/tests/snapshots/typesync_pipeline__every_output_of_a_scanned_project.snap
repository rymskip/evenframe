import type { RecordLink } from './record-link';
import type { Address } from './address';
import type { AuthorId } from './author-id';
import type { NonEmptyString } from './non-empty-string';
import type { Section } from './section';

/** @derive(Decode) */
export interface Author {
  id: string;
  name: NonEmptyString;
  home: Address;
}

/** @derive(Decode) */
export interface Comment {
  body: string;
  author: AuthorId;
  replies: Reply[];
}

/** @derive(Decode) */
export interface Post {
  id: string;
  title: string;
  author: RecordLink<Author>;
  editor: AuthorId;
  subtitle: NonEmptyString | null;
  tags: NonEmptyString[];
  readTime: { secs: number; nanos: number };
  status: Status;
  location: Address;
  outline: Section | null;
  comments: Comment[];
}

/** @derive(Decode) */
export interface Reply {
  body: string;
  thread: Comment[];
}

/** @derive(Decode) */
export interface Scheduled {
  at: string;
  note: string | null;
}

/** @derive(Decode) */
/** @endec({ externallyTagged: true }) */
export type Status =
	| "Draft"
	| { Scheduled: Scheduled }
	| { Archived: string };

