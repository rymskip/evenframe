=== 0-arktype/arktype.ts
import { scope } from 'arktype';
import { RecordIdCodec } from '../record-id.ts';

export const bindings = scope({

Status: [[['===', "Draft"], '|', { Scheduled: 'Scheduled' }], '|', { Archived: 'string' }],
Address: {
  street: 'string',
  city: [['string', '|', 'undefined'], '|', 'null']
},
Comment: {
  body: 'string',
  replies: ['Reply', '[]']
},
Reply: {
  body: 'string',
  thread: ['Comment', '[]']
},
Scheduled: {
  at: 'string',
  note: [['string', '|', 'undefined'], '|', 'null']
},
Section: {
  heading: 'string',
  children: ['Section', '[]']
},
Author: {
  id: 'string',
  name: 'string',
  home: 'Address'
},
Post: {
  id: 'string',
  title: 'string',
  author: ['Author', "|", RecordIdCodec.ark],
  read_time: { '+': 'reject', secs: 'number.integer >= 0', nanos: '0 <= number.integer < 1000000000' },
  status: 'Status',
  location: 'Address',
  outline: [['Section', '|', 'undefined'], '|', 'null'],
  comments: ['Comment', '[]']
},

});

const exported = bindings.export();

export const defaultAddress: Address = {
street: "",
city: null
};
export const defaultComment: Comment = {
body: "",
replies: []
};
export const defaultReply: Reply = {
body: "",
thread: []
};
export const defaultScheduled: Scheduled = {
at: "",
note: null
};
export const defaultSection: Section = {
heading: "",
children: []
};
export const defaultAuthor: Author = {
id: "",
name: "",
home: { street: "", city: null }
};
export const defaultPost: Post = {
id: "",
title: "",
author: RecordIdCodec.empty,
read_time: { secs: 0, nanos: 0 },
status: "Draft",
location: { street: "", city: null },
outline: null,
comments: []
};

export type Status = typeof exported.Status.infer;
export type Address = typeof exported.Address.infer;
export type Comment = typeof exported.Comment.infer;
export type Reply = typeof exported.Reply.infer;
export type Scheduled = typeof exported.Scheduled.infer;
export type Section = typeof exported.Section.infer;
export type Author = typeof exported.Author.infer;
export type Post = typeof exported.Post.infer;

export const validator = exported;

