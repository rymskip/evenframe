import type { RecordLink } from './record-link';
import type { Address } from './address';
import type { Section } from './section';

/** @derive(Deserialize) */
export interface Author {
  id: string;
  name: string;
  home: Address;
}

/** @derive(Deserialize) */
export interface Comment {
  body: string;
  replies: Reply[];
}

/** @derive(Deserialize) */
export interface Post {
  id: string;
  title: string;
  author: RecordLink<Author>;
  read_time: { secs: number; nanos: number };
  status: Status;
  location: Address;
  outline: Section | null;
  comments: Comment[];
}

/** @derive(Deserialize) */
export interface Reply {
  body: string;
  thread: Comment[];
}

/** @derive(Deserialize) */
export interface Scheduled {
  at: string;
  note: string | null;
}

/** @derive(Deserialize) */
/** @serde({ externallyTagged: true }) */
export type Status =
	| "Draft"
	| { Scheduled: Scheduled }
	| { Archived: string };

