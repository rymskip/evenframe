=== 3-macroforge/macroforge.ts
import type { RecordIdEncoded } from '../record-id.ts';

export type RecordLink<T> = RecordIdEncoded | T;

/** @derive(Decode) */
export interface Address {
  street: string;
  city: string | null;
}

/** @derive(Decode) */
export interface Author {
  id: string;
  name: NonEmptyString;
  home: Address;
}

/** @derive(Decode) */
export interface Comment {
  body: string;
  author: AuthorId;
  replies: Reply[];
}

/** @derive(Decode) */
export interface Post {
  id: string;
  title: string;
  author: RecordLink<Author>;
  editor: AuthorId;
  subtitle: NonEmptyString | null;
  tags: NonEmptyString[];
  readTime: { secs: number; nanos: number };
  status: Status;
  location: Address;
  outline: Section | null;
  comments: Comment[];
}

/** @derive(Decode) */
export interface Reply {
  body: string;
  thread: Comment[];
}

/** @derive(Decode) */
export interface Scheduled {
  at: string;
  note: string | null;
}

/** @derive(Decode) */
export interface Section {
  heading: string;
  children: Section[];
}

/** @derive(Decode) */
/** @endec({ externallyTagged: true }) */
export type Status =
	| "Draft"
	| { Scheduled: Scheduled }
	| { Archived: string };

export type AuthorId = $Newtype<string>;

/** @endec({ validate: ["nonEmpty"] }) */
export type NonEmptyString = $Newtype<string>;

