// helpers
export function excludesText_0b1bcbd5(value: unknown): boolean {
	return typeof value === "string" && (!new RegExp("(?:[\\x00-\\x1f\\x7f])").test(value));
}

export function excludesText_555f979d(value: unknown): boolean {
	return typeof value === "string" && (!value.includes("\\"));
}

export function excludesText_84e42d8e(value: unknown): boolean {
	return typeof value === "string" && (!new RegExp("(?:[0-9])").test(value));
