export const bindings = scope({

Role: [['===', "Admin"], '|', ['===', "Member"]],
Collection: {
  id: 'string',
  tags: ['string', '[]'],
  scores: ['number', '[]'],
  metadata: { '+': 'reject', "[string]": 'string' },
  sortedData: { '+': 'reject', "[string]": 'number' },
  notesByRank: { '+': 'reject', "[string.integer]": [['string', '|', 'undefined'], '|', 'null'] },
  relatedByName: { '+': 'reject', "[string]": ['Collection', "|", { '+': 'reject', table: 'string', key: [[{ '+': 'reject', String: 'string' }, '|', { '+': 'reject', Number: 'number.integer' }], '|', { '+': 'reject', Uuid: 'string.uuid' }] }] },
  balanceByOffset: { '+': 'reject', "[string.integer]": 'number' },
  countByLetter: { '+': 'reject', "[/^(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\uD800-\\uDFFF])$/]": 'number' },
  ownerByRole: { '+': 'reject', "Admin?": 'string', "Member?": 'string' },
  labelByAccount: { '+': 'reject', "[string]": 'string' },
  grid: { '+': 'reject', "[string.integer]": { '+': 'reject', "[string.integer]": 'boolean' } },
  initial: new RegExp("^(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\uD800-\\uDFFF])$"),
  noteByFlag: { '+': 'reject', "true?": 'string', "false?": 'string' }
},

});

const exported = bindings.export();

export type Role = typeof exported.Role.infer;
export type Collection = typeof exported.Collection.infer;
