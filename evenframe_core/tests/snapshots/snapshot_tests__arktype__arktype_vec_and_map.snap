export const bindings = scope({

Role: [['===', "Admin"], '|', ['===', "Member"]],
Collection: {
  id: 'string',
  tags: ['string', '[]'],
  scores: ['number', '[]'],
  metadata: { '+': 'reject', "[string]": 'string' },
  sorted_data: { '+': 'reject', "[string]": 'number' },
  notes_by_rank: { '+': 'reject', "[string.integer]": [['string', '|', 'undefined'], '|', 'null'] },
  related_by_name: { '+': 'reject', "[string]": ['Collection', "|", { '+': 'reject', table: 'string', key: [[{ '+': 'reject', String: 'string' }, '|', { '+': 'reject', Number: 'number.integer' }], '|', { '+': 'reject', Uuid: 'string.uuid' }] }] },
  balance_by_offset: { '+': 'reject', "[string.integer]": 'number' },
  count_by_letter: { '+': 'reject', "[/^(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\uD800-\\uDFFF])$/]": 'number' },
  owner_by_role: { '+': 'reject', "Admin?": 'string', "Member?": 'string' },
  label_by_account: { '+': 'reject', "[string]": 'string' },
  grid: { '+': 'reject', "[string.integer]": { '+': 'reject', "[string.integer]": 'boolean' } },
  initial: new RegExp("^(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\uD800-\\uDFFF])$"),
  note_by_flag: { '+': 'reject', "true?": 'string', "false?": 'string' }
},

});

const exported = bindings.export();

export const defaultCollection: Collection = {
id: "",
tags: [],
scores: [],
metadata: {},
sorted_data: {},
notes_by_rank: {},
related_by_name: {},
balance_by_offset: {},
count_by_letter: {},
owner_by_role: {},
label_by_account: {},
grid: {},
initial: "",
note_by_flag: {}
};

export type Role = typeof exported.Role.infer;
export type Collection = typeof exported.Collection.infer;
