/** @derive(Decode) */
export interface Folder {
  /** @endec({ validate: [{ validate: "minLength(3)", message: "must be a short name" }, { validate: "maxLength(9)", message: "must be a short name" }] }) */
  name: string;
  slug: Slug;
}

/** @endec({ validate: [{ validate: "pattern(^[a-z]+$)", message: "must be lowercase letters" }] }) */
export type Slug = $Newtype<string>;
