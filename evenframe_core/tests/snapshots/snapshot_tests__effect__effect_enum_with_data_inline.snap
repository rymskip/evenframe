export class Coordinates extends Schema.Class<Coordinates>("Coordinates")( { 
  lat: Schema.propertySignature(Schema.Number).annotations({ missingMessage: () => `'Lat' is required` }),
  lng: Schema.propertySignature(Schema.Number).annotations({ missingMessage: () => `'Lng' is required` })
}) {[key: string]: unknown}

export const Location = Schema.Union(Schema.Struct({ Address: Schema.String }), Schema.Struct({ Coords: Coordinates }), Schema.Struct({ Inline: Schema.Struct({ label: Schema.propertySignature(Schema.String).annotations({ missingMessage: () => `'Label' is required` }), value: Schema.propertySignature(Schema.Number).annotations({ missingMessage: () => `'Value' is required` }) }) }), Schema.Literal("Unknown")).annotations({ identifier: `Location` });

export interface CoordinatesEncoded {
  readonly lat: number;
  readonly lng: number;
}

export type LocationEncoded = { readonly Address: string } | { readonly Coords: CoordinatesEncoded } | { readonly Inline: { readonly label: string; readonly value: number; } } | "Unknown";


export type CoordinatesType = typeof Coordinates.Type;
export type LocationType = typeof Location.Type;
