---
source: evenframe_core/tests/snapshot_tests.rs
expression: output
---
syntax = "proto3";

enum Role {
    ROLE_UNSPECIFIED = 0;
    ROLE_ADMIN = 1;
    ROLE_MEMBER = 2;
}

message Collection {
    message NotesByRankValue {
        optional string value = 1;
    }
    message GridValue {
        map<uint32, bool> value = 1;
    }
    string id = 1;
    repeated string tags = 2;
    repeated double scores = 3;
    map<string, string> metadata = 4;
    map<string, int32> sorted_data = 5;
    map<uint32, NotesByRankValue> notes_by_rank = 6;
    map<string, .Collection> related_by_name = 7;
    map<int64, double> balance_by_offset = 8;
    map<string, uint32> count_by_letter = 9;
    map<string, string> owner_by_role = 10;
    map<string, string> label_by_account = 11;
    map<uint32, GridValue> grid = 12;
    string initial = 13;
    map<bool, string> note_by_flag = 14;
}
