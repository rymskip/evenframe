---
syntax = "proto3";

message Geometry {
    message Point2D {
        double item_0 = 1;
        double item_1 = 2;
    }
    message Point3D {
        double item_0 = 1;
        double item_1 = 2;
        double item_2 = 3;
    }
    message Labeled {
        string item_0 = 1;
        int32 item_1 = 2;
    }
    Point2D point_2_d = 1;
    Point3D point_3_d = 2;
    Labeled labeled = 3;
}
