union Location {
    LocationAddress,
    LocationCoords,
    LocationInline,
    LocationUnknown
}

table Coordinates {
    lat: double;
    lng: double;
}

table LocationAddress {
    value: string;
}

table LocationCoords {
    value: Coordinates;
}

table LocationInline {
    label: string;
    value: int64;
}

table LocationUnknown {
}
