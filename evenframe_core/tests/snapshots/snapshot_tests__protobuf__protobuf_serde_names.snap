syntax = "proto3";

enum Status {
    STATUS_UNSPECIFIED = 0;
    STATUS_ACTIVE = 1;
    STATUS_ON_HOLD = 2;
}

message Member {
    string id = 1;
    string display_name = 2;
    string zip_code = 3;
    optional string nickname = 4;
    .Status status = 5;
}
