export type RecordLink<T> = { table: string; key: { String: string } | { Number: number } | { Uuid: string } } | T;

/** @derive(Decode) */
export interface Collection {
  id: string;
  tags: string[];
  scores: number[];
  metadata: Record<string, string>;
  sorted_data: Record<string, number>;
  notes_by_rank: Record<number, string | null>;
  related_by_name: Record<string, RecordLink<Collection>>;
  balance_by_offset: Record<number, number>;
  count_by_letter: Record<string, number>;
  owner_by_role: Partial<Record<Role, string>>;
  label_by_account: Record<string, string>;
  grid: Record<number, Record<number, boolean>>;
  /** @endec({ validate: ["pattern(^(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\uD800-\\uDFFF])$)"] }) */
  initial: string;
  note_by_flag: Partial<Record<"true" | "false", string>>;
}

/** @derive(Decode) */
/** @endec({ externallyTagged: true }) */
export type Role =
	| "Admin"
	| "Member";
