export type RecordLink<T> = { table: string; key: { String: string } | { Number: number } | { Uuid: string } } | T;

/** @derive(Decode) */
export interface Author {
  id: string;
  name: string;
}

/** @derive(Decode) */
export interface Post {
  id: string;
  title: string;
  author: RecordLink<Author>;
  relatedPosts: RecordLink<Post>[];
}
