export type RecordLink<T> = string | T;

/** @derive(Deserialize) */
export interface Author {
  /** @serde({ validate: ["nonEmpty"] }) */
  id: string;
  /** @serde({ validate: ["nonEmpty"] }) */
  name: string;
}

/** @derive(Deserialize) */
export interface Post {
  /** @serde({ validate: ["nonEmpty"] }) */
  id: string;
  /** @serde({ validate: ["nonEmpty"] }) */
  title: string;
  author: RecordLink<Author>;
  relatedPosts: RecordLink<Post>[];
}
