export const bindings = scope({

Payload: [{ kind: ['===', "Click"], x: 'number' }, '|', { kind: ['===', "Close"] }],
Audit: {
  createdBy: 'string'
},
Event: [{
  at: 'string'
}, '&', 'Payload'],
Geo: {
  lat: 'number',
  lon: 'number'
},
Post: {
  title: 'string',
  createdBy: 'string',
  "lat?": [['number', '|', 'undefined'], '|', 'null'],
  "lon?": [['number', '|', 'undefined'], '|', 'null']
},
Settings: {
  theme: 'string',
  "[string]": ['number', '|', 'string']
},

});

const exported = bindings.export();

export type Payload = typeof exported.Payload.infer;
export type Audit = typeof exported.Audit.infer;
export type Event = typeof exported.Event.infer;
export type Geo = typeof exported.Geo.infer;
export type Post = typeof exported.Post.infer;
export type Settings = typeof exported.Settings.infer;
