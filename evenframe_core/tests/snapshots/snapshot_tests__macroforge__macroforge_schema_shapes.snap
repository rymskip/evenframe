/** @derive(Decode) */
export interface Moved {
  from: Place;
  to: Place;
}

/** @derive(Decode) */
export interface Place {
  name: string;
}

/** @derive(Decode) */
export interface Shapes {
  maybeTags: string[] | null;
  matrix: number[][];
  gaps: (number | null)[];
  triState: (boolean | null) | null;
  maybeCount: number | null;
  listsByName: Record<string, string[]>;
  optionalByName: Record<string, number | null>;
  mapsByName: Record<string, Record<number, boolean>>;
  pair: [string, number];
  pairs: [number, number][];
  corner: { x: number; y: number };
  nothing: null;
  huge: number;
  hugeById: Record<number, string>;
  event: Event;
  events: Event[];
  lastEvent: Event | null;
  eventsByName: Record<string, Event>;
}

/** @derive(Decode) */
/** @endec({ externallyTagged: true }) */
export type Event =
	| "Opened"
	| { Moved: Moved }
	| { Tagged: string[] }
	| { Visited: Place }
	| { Scored: number }
	| { Pinned: [number, number] }
	| { Cleared: [] };
