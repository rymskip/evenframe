/** @derive(Decode) */
export interface Moved {
  from: Place;
  to: Place;
}

/** @derive(Decode) */
export interface Place {
  name: string;
}

/** @derive(Decode) */
export interface Shapes {
  maybe_tags: string[] | null;
  matrix: number[][];
  gaps: (number | null)[];
  tri_state: (boolean | null) | null;
  maybe_count: number | null;
  lists_by_name: Record<string, string[]>;
  optional_by_name: Record<string, number | null>;
  maps_by_name: Record<string, Record<number, boolean>>;
  pair: [string, number];
  pairs: [number, number][];
  corner: { x: number; y: number };
  nothing: null;
  huge: number;
  huge_by_id: Record<number, string>;
  event: Event;
  events: Event[];
  last_event: Event | null;
  events_by_name: Record<string, Event>;
}

/** @derive(Decode) */
/** @endec({ externallyTagged: true }) */
export type Event =
	| "Opened"
	| { Moved: Moved }
	| { Tagged: string[] }
	| { Visited: Place }
	| { Scored: number }
	| { Pinned: [number, number] }
	| { Cleared: [] };
