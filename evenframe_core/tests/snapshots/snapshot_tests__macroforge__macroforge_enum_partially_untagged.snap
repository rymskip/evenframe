/** @derive(Decode) */
export interface Phone {
  number: string;
}

/** @derive(Decode) */
export interface Postal {
  street: string;
  city: string;
}

/** @derive(Decode) */
/** @endec({ untagged: true }) */
export type Contact =
	| { kind: "Phone" } & Phone
	| { kind: "Nobody" }
	| string
	| Postal;
