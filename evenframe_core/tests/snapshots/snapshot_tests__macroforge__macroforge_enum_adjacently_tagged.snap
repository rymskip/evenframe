/** @derive(Deserialize) */
export interface ClickData {
  x: number;
  y: number;
}

/** @derive(Deserialize) */
/** @serde({ tag: "t", content: "c" }) */
export type Event =
	| { t: "Click"; c: ClickData }
	| { t: "KeyPress"; c: string }
	| { t: "Scroll" };
