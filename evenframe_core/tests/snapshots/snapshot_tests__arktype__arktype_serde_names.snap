export const bindings = scope({

Status: [['===', "active"], '|', ['===', "on-hold"]],
Member: {
  id: 'string',
  displayName: ['string', '&', 'string >= 2'],
  "zip-code": 'string',
  "nickname?": [['string', '|', 'undefined'], '|', 'null'],
  status: 'Status'
},

});

const exported = bindings.export();

export type Status = typeof exported.Status.infer;
export type Member = typeof exported.Member.infer;
