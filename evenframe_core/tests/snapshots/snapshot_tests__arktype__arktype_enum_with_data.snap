export const bindings = scope({

Location: [[[{ Address: 'string' }, '|', { Coords: 'Coordinates' }], '|', { Inline: 'InlineData' }], '|', ['===', "Unknown"]],
Coordinates: {
  lat: 'number',
  lng: 'number'
},
InlineData: {
  label: 'string',
  value: 'number'
},

});

const exported = bindings.export();

export const defaultCoordinates: Coordinates = {
lat: 0,
lng: 0
};
export const defaultInlineData: InlineData = {
label: "",
value: 0
};

export type Location = typeof exported.Location.infer;
export type Coordinates = typeof exported.Coordinates.infer;
export type InlineData = typeof exported.InlineData.infer;
