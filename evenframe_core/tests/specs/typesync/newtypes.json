{
  "description": "Newtypes: branded over a primitive (with Macroforge derives), over another newtype, over an enum, over a text form, without validators, and the tuple and unit shapes, held directly, optionally, in a Vec, as a map key, and behind a field's morph, beside a text-form field",
  "structs": {
    "Profile": {
      "struct_name": "Profile",
      "fields": [
        { "field_name": "name", "field_type": { "Other": "NonEmptyString" }, "validators": [], "always_regenerate": false },
        { "field_name": "nickname", "field_type": { "Option": { "Other": "NonEmptyString" } }, "validators": [], "always_regenerate": false },
        { "field_name": "handles", "field_type": { "Vec": { "Other": "Handle" } }, "validators": [], "always_regenerate": false },
        { "field_name": "visits", "field_type": { "HashMap": [{ "Other": "NonEmptyString" }, { "Other": "Count" }] }, "validators": [], "always_regenerate": false },
        { "field_name": "label", "field_type": { "Other": "Label" }, "validators": [], "always_regenerate": false },
        { "field_name": "position", "field_type": { "Other": "Pair" }, "validators": [], "always_regenerate": false },
        { "field_name": "marker", "field_type": { "Other": "Marker" }, "validators": [], "always_regenerate": false },
        { "field_name": "status", "field_type": { "Other": "StatusCode" }, "validators": [], "always_regenerate": false },
        { "field_name": "title", "field_type": { "Other": "NonEmptyString" }, "morphs": [{ "StringMorph": "Trim" }], "validators": [], "always_regenerate": false },
        { "field_name": "age", "field_type": { "FromText": "U8" }, "validators": [{ "NumberValidator": { "GreaterThanOrEqualTo": 18.0 } }], "always_regenerate": false }
      ]
    }
  },
  "enums": {
    "Status": {
      "enum_name": "Status",
      "variants": [
        { "name": "Active" },
        { "name": "Inactive" }
      ]
    }
  },
  "newtypes": {
    "NonEmptyString": {
      "name": "NonEmptyString",
      "inner": "String",
      "validators": [{ "StringValidator": "NonEmpty" }],
      "macroforge_derives": ["Encode", "Decode"]
    },
    "Handle": {
      "name": "Handle",
      "inner": { "Other": "NonEmptyString" },
      "morphs": [{ "StringMorph": "Trim" }, { "StringMorph": "Lower" }],
      "validators": []
    },
    "Count": {
      "name": "Count",
      "inner": { "FromText": "I64" },
      "validators": [{ "NumberValidator": { "GreaterThanOrEqualTo": 0.0 } }]
    },
    "Label": {
      "name": "Label",
      "inner": "String"
    },
    "StatusCode": {
      "name": "StatusCode",
      "inner": { "Other": "Status" }
    },
    "Pair": {
      "name": "Pair",
      "inner": { "Tuple": ["String", "U32"] },
      "kind": "Alias"
    },
    "Marker": {
      "name": "Marker",
      "inner": "Unit",
      "kind": "Alias"
    }
  }
}
