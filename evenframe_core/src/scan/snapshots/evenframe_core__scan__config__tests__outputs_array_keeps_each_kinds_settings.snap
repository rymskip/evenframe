---
source: evenframe_core/src/scan/config.rs
expression: config.outputs
---
[
    TypesyncOutput {
        kind: Arktype,
        dir: "/nonexistent-evenframe-project/generated/arktype",
        file: Some(
            "schemas.ts",
        ),
        files: OutputConfig {
            mode: Single,
            barrel_file: false,
            file_naming: Kebab,
            file_extension: ".ts",
            array_style: Shorthand,
            import_extension: Bare,
        },
        namespace: None,
        package: None,
        import_validate: false,
        macros: {},
        default_derives: None,
    },
    TypesyncOutput {
        kind: Protobuf,
        dir: "/nonexistent-evenframe-project/proto",
        file: None,
        files: OutputConfig {
            mode: Single,
            barrel_file: false,
            file_naming: Kebab,
            file_extension: ".ts",
            array_style: Shorthand,
            import_extension: Bare,
        },
        namespace: None,
        package: Some(
            "com.example",
        ),
        import_validate: true,
        macros: {},
        default_derives: None,
    },
]
