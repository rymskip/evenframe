---
source: evenframe_core/src/scan/config.rs
expression: config.outputs
---
[
    TypesyncOutput {
        kind: Macroforge,
        dir: "/nonexistent-evenframe-project/generated",
        file: None,
        files: OutputConfig {
            mode: PerFile,
            barrel_file: false,
            file_naming: Kebab,
            file_extension: ".svelte.ts",
            array_style: Shorthand,
            import_extension: Js,
        },
        namespace: None,
        package: None,
        import_validate: false,
        macros: {
            "Form": "@app/forms",
        },
        default_derives: Some(
            [
                "Default",
                "Encode",
                "Form",
            ],
        ),
    },
]
