{
	"name": "evenframe-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite dev",
		"serve": "deno run -A npm:wrangler dev",
		"deploy": "deno task build && deno run -A npm:wrangler deploy",
		"deploy:check": "deno run -A npm:wrangler deploy --dry-run",
		"format": "deno run -A npm:@biomejs/biome check --write .",
		"lint": "deno run -A npm:@biomejs/biome check --error-on-warnings .",
		"check": "deno run -A npm:@sveltejs/kit sync && deno run -A npm:svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "deno run -A npm:@playwright/test test",
		"verify": "deno task lint && deno task check && deno task build && deno task test && deno task deploy:check"
	},
	"dependencies": {
		"@lucide/svelte": "^1.53.0",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"github-slugger": "^2.0.0",
		"marked": "^18.1.0",
		"sanitize-html": "^2.18.0",
		"shiki": "^4.5.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@types/sanitize-html": "^2.16.2",
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.149.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
